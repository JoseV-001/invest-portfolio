# ==============================================================================
# INVEST PORTFOLIO - HOMELAB & PRODUCTION ENVIRONMENT CONFIGURATION
# Copie este arquivo para .env na raiz do projeto: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PORTAS EXTERNAS DO HOST (Evita conflitos com outros containers no servidor)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 2. CREDENCIAIS DO BANCO DE DADOS (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=invest_db
POSTGRES_USER=invest_user
POSTGRES_PASSWORD=invest_secure_pwd

# ------------------------------------------------------------------------------
# 3. REDE, CORS & URL PÚBLICA DA API
# ------------------------------------------------------------------------------
# Deixe NEXT_PUBLIC_API_URL vazio para resolução automática via IP/Domínio atual + BACKEND_PORT,
# ou defina explicitamente caso utilize Reverse Proxy / Domínio (ex: https://api.seudominio.com/api/v1)
NEXT_PUBLIC_API_URL=

# Origens permitidas no CORS do Backend (separadas por vírgula; aceita padrões com curinga)
# Exemplos:
#   Desenvolvimento / LAN aberta: *
#   Produção / Homelab restrito: http://localhost:3000,http://192.168.1.*:*,https://invest.seudominio.com
CORS_ALLOWED_ORIGINS=*

# Tipo de cache no Spring Boot (redis ou simple)
SPRING_CACHE_TYPE=redis

# ------------------------------------------------------------------------------
# 4. CHAVES DE PROVEDORES DE COTAÇÕES (Opcional - Possui Fallback Yahoo Finance)
# ------------------------------------------------------------------------------
# Brapi.dev (Ativos B3: Ações, FIIs, ETFs, Units) -> https://brapi.dev
BRAPI_TOKEN=
BRAPI_MIN_INTERVAL_MS=400

# Finnhub.io (Ativos EUA: Stocks, REITs, ETFs) -> https://finnhub.io
FINNHUB_API_KEY=
